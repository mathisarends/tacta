{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@tacta/core": ["./packages/core/src/index.ts"],
      "@tacta/core/*": ["./packages/core/src/*"],
      "@tacta/workspace-panel": ["./packages/workspace-panel/src/index.ts"],
      "@tacta/workspace-panel/*": ["./packages/workspace-panel/src/*"],
      "@tacta/sidebar": ["./packages/sidebar/src/index.ts"],
      "@tacta/sidebar/*": ["./packages/sidebar/src/*"],
      "@tacta/workspace": ["./packages/workspace/src/index.ts"],
      "@tacta/workspace/*": ["./packages/workspace/src/*"],
      "@tacta/question": ["./packages/question/src/index.ts"],
      "@tacta/question/*": ["./packages/question/src/*"],
      "@tacta/voice-input": ["./packages/voice-input/src/index.ts"],
      "@tacta/voice-input/*": ["./packages/voice-input/src/*"],
      "@tacta/markdown": ["./packages/markdown/src/index.ts"],
      "@tacta/markdown/*": ["./packages/markdown/src/*"],
      "@tacta/chat": ["./packages/chat/src/index.ts"],
      "@tacta/chat/*": ["./packages/chat/src/*"],
      "@tacta/terminal": ["./packages/terminal/src/index.ts"],
      "@tacta/terminal/*": ["./packages/terminal/src/*"],
      "@tacta/browser": ["./packages/browser/src/index.ts"],
      "@tacta/browser/*": ["./packages/browser/src/*"],
      "@tacta/image-editor": ["./packages/image-editor/src/index.ts"],
      "@tacta/image-editor/*": ["./packages/image-editor/src/*"],
      "@tacta/file-preview": ["./packages/file-preview/src/index.ts"],
      "@tacta/file-preview/*": ["./packages/file-preview/src/*"],
      "@tacta/code-diff": ["./packages/code-diff/src/index.ts"],
      "@tacta/code-diff/*": ["./packages/code-diff/src/*"],
      "@tacta/markdown-document": ["./packages/markdown-document/src/index.ts"],
      "@tacta/markdown-document/*": ["./packages/markdown-document/src/*"],
      "@tacta/controls": ["./packages/controls/src/index.ts"],
      "@tacta/controls/*": ["./packages/controls/src/*"],
      "@tacta/search": ["./packages/search/src/index.ts"],
      "@tacta/search/*": ["./packages/search/src/*"],
      "@tacta/notifications": ["./packages/notifications/src/index.ts"],
      "@tacta/notifications/*": ["./packages/notifications/src/*"],
      "@tacta/file-explorer": ["./packages/file-explorer/src/index.ts"],
      "@tacta/file-explorer/*": ["./packages/file-explorer/src/*"],
      "@tacta/settings": ["./packages/settings/src/index.ts"],
      "@tacta/settings/*": ["./packages/settings/src/*"]
    },
    "types": ["node", "vite/client"]
  },
  "include": ["packages/*/src/**/*.ts", "test/**/*.ts", "examples/**/*.ts", "vitest.config.ts"]
}
