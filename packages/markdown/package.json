{
  "name": "@tacta/markdown",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Tacta markdown extension: composable Lit Web Components",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/register.js",
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mathisarends/tacta.git",
    "directory": "packages/markdown"
  },
  "dependencies": {
    "@tacta/core": "0.1.0",
    "lit": "^3.3.3",
    "marked": "^18.0.9",
    "dompurify": "^3.4.14",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@lezer/highlight": "^1.2.5"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./markdown/highlight-code": {
      "types": "./dist/markdown/highlight-code.d.ts",
      "default": "./dist/markdown/highlight-code.js"
    },
    "./markdown": {
      "types": "./dist/markdown/index.d.ts",
      "default": "./dist/markdown/index.js"
    },
    "./markdown/render": {
      "types": "./dist/markdown/render.d.ts",
      "default": "./dist/markdown/render.js"
    },
    "./markdown/styles": {
      "types": "./dist/markdown/styles.d.ts",
      "default": "./dist/markdown/styles.js"
    }
  }
}
