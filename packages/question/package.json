{
  "name": "@tacta/question",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Tacta question extension: composable Lit Web Components",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/register.js",
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mathisarends/tacta.git",
    "directory": "packages/question"
  },
  "dependencies": {
    "@tacta/core": "0.1.0",
    "lit": "^3.3.3"
  },
  "exports": {
    "./define": {
      "types": "./dist/define.d.ts",
      "default": "./dist/define.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./messages/de": {
      "types": "./dist/messages/de.d.ts",
      "default": "./dist/messages/de.js"
    },
    "./messages/en": {
      "types": "./dist/messages/en.d.ts",
      "default": "./dist/messages/en.js"
    },
    "./messages": {
      "types": "./dist/messages/index.d.ts",
      "default": "./dist/messages/index.js"
    },
    "./question.styles": {
      "types": "./dist/question.styles.d.ts",
      "default": "./dist/question.styles.js"
    },
    "./question": {
      "types": "./dist/question.d.ts",
      "default": "./dist/question.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    }
  }
}
