{
  "name": "@tacta/file-preview",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Tacta file-preview extension: composable Lit Web Components",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/register.js",
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mathisarends/tacta.git",
    "directory": "packages/file-preview"
  },
  "dependencies": {
    "@tacta/core": "0.1.0",
    "lit": "^3.3.3",
    "pdfjs-dist": "^6.4.299",
    "docx-preview": "^0.4.1",
    "dompurify": "^3.4.14",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "@tacta/image-editor": "0.1.0"
  },
  "exports": {
    "./define": {
      "types": "./dist/define.d.ts",
      "default": "./dist/define.js"
    },
    "./file-preview": {
      "types": "./dist/file-preview.d.ts",
      "default": "./dist/file-preview.js"
    },
    "./formats": {
      "types": "./dist/formats.d.ts",
      "default": "./dist/formats.js"
    },
    "./image-preview": {
      "types": "./dist/image-preview.d.ts",
      "default": "./dist/image-preview.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./messages/de": {
      "types": "./dist/messages/de.d.ts",
      "default": "./dist/messages/de.js"
    },
    "./messages/en": {
      "types": "./dist/messages/en.d.ts",
      "default": "./dist/messages/en.js"
    },
    "./messages": {
      "types": "./dist/messages/index.d.ts",
      "default": "./dist/messages/index.js"
    },
    "./pdf-preview": {
      "types": "./dist/pdf-preview.d.ts",
      "default": "./dist/pdf-preview.js"
    },
    "./preview.styles": {
      "types": "./dist/preview.styles.d.ts",
      "default": "./dist/preview.styles.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./spreadsheet-preview": {
      "types": "./dist/spreadsheet-preview.d.ts",
      "default": "./dist/spreadsheet-preview.js"
    },
    "./spreadsheet-types": {
      "types": "./dist/spreadsheet-types.d.ts",
      "default": "./dist/spreadsheet-types.js"
    },
    "./spreadsheet.worker": {
      "types": "./dist/spreadsheet.worker.d.ts",
      "default": "./dist/spreadsheet.worker.js"
    },
    "./word-preview": {
      "types": "./dist/word-preview.d.ts",
      "default": "./dist/word-preview.js"
    }
  }
}
