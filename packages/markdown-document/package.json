{
  "name": "@tacta/markdown-document",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Tacta markdown-document extension: composable Lit Web Components",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/register.js",
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mathisarends/tacta.git",
    "directory": "packages/markdown-document"
  },
  "dependencies": {
    "@tacta/core": "0.1.0",
    "lit": "^3.3.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.0",
    "yaml": "^2.9.1",
    "@tacta/markdown": "0.1.0"
  },
  "exports": {
    "./define": {
      "types": "./dist/define.d.ts",
      "default": "./dist/define.js"
    },
    "./empty-file": {
      "types": "./dist/empty-file.d.ts",
      "default": "./dist/empty-file.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./live-preview": {
      "types": "./dist/live-preview.d.ts",
      "default": "./dist/live-preview.js"
    },
    "./markdown-editor": {
      "types": "./dist/markdown-editor.d.ts",
      "default": "./dist/markdown-editor.js"
    },
    "./messages/de": {
      "types": "./dist/messages/de.d.ts",
      "default": "./dist/messages/de.js"
    },
    "./messages/en": {
      "types": "./dist/messages/en.d.ts",
      "default": "./dist/messages/en.js"
    },
    "./messages": {
      "types": "./dist/messages/index.d.ts",
      "default": "./dist/messages/index.js"
    },
    "./metadata-preview": {
      "types": "./dist/metadata-preview.d.ts",
      "default": "./dist/metadata-preview.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./source-document": {
      "types": "./dist/source-document.d.ts",
      "default": "./dist/source-document.js"
    },
    "./table-preview": {
      "types": "./dist/table-preview.d.ts",
      "default": "./dist/table-preview.js"
    }
  }
}
