{
  "name": "@tacta/workspace-panel",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Tacta workspace-panel extension: composable Lit Web Components",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/register.js",
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mathisarends/tacta.git",
    "directory": "packages/workspace-panel"
  },
  "dependencies": {
    "@tacta/core": "0.1.0",
    "lit": "^3.3.3"
  },
  "exports": {
    "./define": {
      "types": "./dist/define.d.ts",
      "default": "./dist/define.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "default": "./dist/events.js"
    },
    "./explorer-splitter": {
      "types": "./dist/explorer-splitter.d.ts",
      "default": "./dist/explorer-splitter.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./messages/de": {
      "types": "./dist/messages/de.d.ts",
      "default": "./dist/messages/de.js"
    },
    "./messages/en": {
      "types": "./dist/messages/en.d.ts",
      "default": "./dist/messages/en.js"
    },
    "./messages": {
      "types": "./dist/messages/index.d.ts",
      "default": "./dist/messages/index.js"
    },
    "./panel-splitter": {
      "types": "./dist/panel-splitter.d.ts",
      "default": "./dist/panel-splitter.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./split-pane": {
      "types": "./dist/split-pane.d.ts",
      "default": "./dist/split-pane.js"
    },
    "./surface-menu": {
      "types": "./dist/surface-menu.d.ts",
      "default": "./dist/surface-menu.js"
    },
    "./surface-picker.styles": {
      "types": "./dist/surface-picker.styles.d.ts",
      "default": "./dist/surface-picker.styles.js"
    },
    "./surface-picker": {
      "types": "./dist/surface-picker.d.ts",
      "default": "./dist/surface-picker.js"
    },
    "./surfaces": {
      "types": "./dist/surfaces.d.ts",
      "default": "./dist/surfaces.js"
    },
    "./tab-drag-controller": {
      "types": "./dist/tab-drag-controller.d.ts",
      "default": "./dist/tab-drag-controller.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./workspace-tab-bar": {
      "types": "./dist/workspace-tab-bar.d.ts",
      "default": "./dist/workspace-tab-bar.js"
    },
    "./workspace-tab": {
      "types": "./dist/workspace-tab.d.ts",
      "default": "./dist/workspace-tab.js"
    },
    "./workspace-tabs.styles": {
      "types": "./dist/workspace-tabs.styles.d.ts",
      "default": "./dist/workspace-tabs.styles.js"
    }
  }
}
