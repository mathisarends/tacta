{
  "name": "@tacta/notifications",
  "version": "0.1.0",
  "description": "Composable notifications Web Components for Tacta",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/register.js",
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mathisarends/tacta.git",
    "directory": "packages/notifications"
  },
  "dependencies": {
    "@tacta/core": "0.1.0",
    "lit": "^3.3.3"
  },
  "exports": {
    "./define": {
      "types": "./dist/define.d.ts",
      "default": "./dist/define.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./toast-region": {
      "types": "./dist/toast-region.d.ts",
      "default": "./dist/toast-region.js"
    },
    "./toast-store": {
      "types": "./dist/toast-store.d.ts",
      "default": "./dist/toast-store.js"
    },
    "./toast": {
      "types": "./dist/toast.d.ts",
      "default": "./dist/toast.js"
    }
  }
}
