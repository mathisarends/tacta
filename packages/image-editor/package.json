{
  "name": "@tacta/image-editor",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Tacta image-editor extension: composable Lit Web Components",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/register.js",
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mathisarends/tacta.git",
    "directory": "packages/image-editor"
  },
  "dependencies": {
    "@tacta/core": "0.1.0",
    "lit": "^3.3.3"
  },
  "exports": {
    "./annotation-colors": {
      "types": "./dist/annotation-colors.d.ts",
      "default": "./dist/annotation-colors.js"
    },
    "./annotation-types": {
      "types": "./dist/annotation-types.d.ts",
      "default": "./dist/annotation-types.js"
    },
    "./annotations": {
      "types": "./dist/annotations.d.ts",
      "default": "./dist/annotations.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "default": "./dist/define.js"
    },
    "./image-canvas": {
      "types": "./dist/image-canvas.d.ts",
      "default": "./dist/image-canvas.js"
    },
    "./image-color-picker.styles": {
      "types": "./dist/image-color-picker.styles.d.ts",
      "default": "./dist/image-color-picker.styles.js"
    },
    "./image-color-picker": {
      "types": "./dist/image-color-picker.d.ts",
      "default": "./dist/image-color-picker.js"
    },
    "./image-editor-actions": {
      "types": "./dist/image-editor-actions.d.ts",
      "default": "./dist/image-editor-actions.js"
    },
    "./image-editor": {
      "types": "./dist/image-editor.d.ts",
      "default": "./dist/image-editor.js"
    },
    "./image-shortcuts": {
      "types": "./dist/image-shortcuts.d.ts",
      "default": "./dist/image-shortcuts.js"
    },
    "./image-text-input": {
      "types": "./dist/image-text-input.d.ts",
      "default": "./dist/image-text-input.js"
    },
    "./image-tools": {
      "types": "./dist/image-tools.d.ts",
      "default": "./dist/image-tools.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./messages/de": {
      "types": "./dist/messages/de.d.ts",
      "default": "./dist/messages/de.js"
    },
    "./messages/en": {
      "types": "./dist/messages/en.d.ts",
      "default": "./dist/messages/en.js"
    },
    "./messages": {
      "types": "./dist/messages/index.d.ts",
      "default": "./dist/messages/index.js"
    },
    "./movable-toolbar": {
      "types": "./dist/movable-toolbar.d.ts",
      "default": "./dist/movable-toolbar.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    }
  }
}
