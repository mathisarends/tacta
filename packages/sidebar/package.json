{
  "name": "@tacta/sidebar",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Tacta sidebar extension: composable Lit Web Components",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/register.js",
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mathisarends/tacta.git",
    "directory": "packages/sidebar"
  },
  "dependencies": {
    "@tacta/core": "0.1.0",
    "lit": "^3.3.3"
  },
  "exports": {
    "./define": {
      "types": "./dist/define.d.ts",
      "default": "./dist/define.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./navigation-types": {
      "types": "./dist/navigation-types.d.ts",
      "default": "./dist/navigation-types.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./sidebar/conversation-row": {
      "types": "./dist/sidebar/conversation-row.d.ts",
      "default": "./dist/sidebar/conversation-row.js"
    },
    "./sidebar": {
      "types": "./dist/sidebar/index.d.ts",
      "default": "./dist/sidebar/index.js"
    },
    "./sidebar/messages/de": {
      "types": "./dist/sidebar/messages/de.d.ts",
      "default": "./dist/sidebar/messages/de.js"
    },
    "./sidebar/messages/en": {
      "types": "./dist/sidebar/messages/en.d.ts",
      "default": "./dist/sidebar/messages/en.js"
    },
    "./sidebar/messages": {
      "types": "./dist/sidebar/messages/index.d.ts",
      "default": "./dist/sidebar/messages/index.js"
    },
    "./sidebar/profile-menu": {
      "types": "./dist/sidebar/profile-menu.d.ts",
      "default": "./dist/sidebar/profile-menu.js"
    },
    "./sidebar/rename-dialog": {
      "types": "./dist/sidebar/rename-dialog.d.ts",
      "default": "./dist/sidebar/rename-dialog.js"
    },
    "./sidebar/side-bar.styles": {
      "types": "./dist/sidebar/side-bar.styles.d.ts",
      "default": "./dist/sidebar/side-bar.styles.js"
    },
    "./sidebar/side-bar": {
      "types": "./dist/sidebar/side-bar.d.ts",
      "default": "./dist/sidebar/side-bar.js"
    },
    "./sidebar/types": {
      "types": "./dist/sidebar/types.d.ts",
      "default": "./dist/sidebar/types.js"
    },
    "./sidebar/user-profile": {
      "types": "./dist/sidebar/user-profile.d.ts",
      "default": "./dist/sidebar/user-profile.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "default": "./dist/events.js"
    }
  }
}
