{
  "name": "@tacta/voice-input",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Tacta voice-input extension: composable Lit Web Components",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/register.js",
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mathisarends/tacta.git",
    "directory": "packages/voice-input"
  },
  "dependencies": {
    "@tacta/core": "0.1.0",
    "lit": "^3.3.3"
  },
  "exports": {
    "./define": {
      "types": "./dist/define.d.ts",
      "default": "./dist/define.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./voice-input": {
      "types": "./dist/voice-input/index.d.ts",
      "default": "./dist/voice-input/index.js"
    },
    "./voice-input/messages/de": {
      "types": "./dist/voice-input/messages/de.d.ts",
      "default": "./dist/voice-input/messages/de.js"
    },
    "./voice-input/messages/en": {
      "types": "./dist/voice-input/messages/en.d.ts",
      "default": "./dist/voice-input/messages/en.js"
    },
    "./voice-input/messages": {
      "types": "./dist/voice-input/messages/index.d.ts",
      "default": "./dist/voice-input/messages/index.js"
    },
    "./voice-input/speech-session": {
      "types": "./dist/voice-input/speech-session.d.ts",
      "default": "./dist/voice-input/speech-session.js"
    },
    "./voice-input/voice-input.styles": {
      "types": "./dist/voice-input/voice-input.styles.d.ts",
      "default": "./dist/voice-input/voice-input.styles.js"
    },
    "./voice-input/voice-input": {
      "types": "./dist/voice-input/voice-input.d.ts",
      "default": "./dist/voice-input/voice-input.js"
    }
  }
}
